# Скопируйте этот файл в .env для локальной разработки (по желанию) и
# задайте такие же переменные в Railway → Variables для продакшена.

# Сгенерируйте свой секретный ключ, например:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# В продакшене держите False
DEBUG=False

# Через запятую. Railway сам добавит RAILWAY_PUBLIC_DOMAIN в ALLOWED_HOSTS,
# так что тут можно оставить пусто или '*' на первое время.
ALLOWED_HOSTS=*

# Заполняется автоматически, если в Railway подключён плагин PostgreSQL
# (переменная DATABASE_URL появится в сервисе сама после добавления базы).
# DATABASE_URL=postgres://user:password@host:port/dbname
